---
// 메인 상단 배너: 창가에서 노트북 하는 마스코트 일러스트 + 손글씨 문구
import { HERO } from '../consts';
---

<section class="hero" aria-label="블로그 배너">
  <svg class="hero-art" viewBox="0 0 1200 260" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="h-wall" x1="0" x2="1">
        <stop offset="0" stop-color="#f6dfb8" /><stop offset="0.5" stop-color="#fbe9cc" /><stop offset="1" stop-color="#f2d2a2" />
      </linearGradient>
      <linearGradient id="h-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#8fc3e8" /><stop offset="0.6" stop-color="#cfe4f2" /><stop offset="1" stop-color="#fbe3c4" />
      </linearGradient>
      <linearGradient id="h-light" x1="0" x2="1">
        <stop offset="0" stop-color="#fff6e3" stop-opacity="0" /><stop offset="0.5" stop-color="#fff6e3" stop-opacity="0.5" /><stop offset="1" stop-color="#fff6e3" stop-opacity="0" />
      </linearGradient>
    </defs>
    <rect width="1200" height="260" fill="url(#h-wall)" />

    <!-- 창문과 바깥 풍경 -->
    <rect x="400" y="-10" width="420" height="250" fill="url(#h-sky)" />
    <g fill="#fff" opacity="0.9">
      <ellipse cx="470" cy="60" rx="50" ry="14" /><ellipse cx="510" cy="50" rx="34" ry="14" />
      <ellipse cx="700" cy="40" rx="60" ry="12" /><ellipse cx="740" cy="32" rx="30" ry="12" />
    </g>
    <g fill="#9bb7d6" opacity="0.75">
      <rect x="430" y="150" width="30" height="80" /><rect x="465" y="120" width="22" height="110" rx="3" />
      <rect x="492" y="160" width="40" height="70" /><rect x="560" y="135" width="26" height="95" />
      <rect x="640" y="145" width="34" height="85" /><rect x="680" y="125" width="20" height="105" rx="3" />
      <rect x="740" y="155" width="44" height="75" />
    </g>
    <rect x="400" y="-10" width="420" height="250" fill="none" stroke="#c99a68" stroke-width="12" />
    <line x1="610" y1="-10" x2="610" y2="240" stroke="#c99a68" stroke-width="8" />
    <rect x="380" y="210" width="460" height="16" rx="4" fill="#d9a774" />
    <path d="M345 -10 h65 c-10 90 -6 170 10 270 h-75Z" fill="#f8ecd6" opacity="0.9" />
    <path d="M875 -10 h-65 c10 90 6 170 -10 270 h75Z" fill="#f8ecd6" opacity="0.9" />
    <rect x="300" y="0" width="620" height="260" fill="url(#h-light)" />

    <!-- 왼쪽 화분 잎 -->
    <g fill="#8fb36a" stroke="#5f8a45" stroke-width="2">
      <path d="M40 260 C30 200 60 160 110 150 C100 200 80 230 40 260Z" />
      <path d="M90 260 C100 190 150 170 190 180 C170 220 140 245 90 260Z" />
      <path d="M20 200 C0 150 20 110 60 100 C70 140 55 175 20 200Z" />
      <path d="M150 260 C170 210 220 205 250 220 C225 250 190 260 150 260Z" />
      <path d="M-10 120 C-20 70 0 40 40 30 C50 70 30 100 -10 120Z" />
    </g>
    <g transform="rotate(-4 125 80)">
      <rect x="95" y="55" width="70" height="80" rx="3" fill="#fff8ea" stroke="#d6b88e" />
      <rect x="120" y="48" width="20" height="12" rx="2" fill="#e8c27f" />
      <g stroke="#c8a77a" stroke-width="2"><line x1="105" y1="78" x2="155" y2="78" /><line x1="105" y1="92" x2="150" y2="92" /><line x1="105" y1="106" x2="145" y2="106" /></g>
    </g>

    <!-- 오른쪽 메모지 -->
    <g transform="rotate(6 1050 90)">
      <rect x="985" y="18" width="140" height="150" rx="4" fill="#fffaf0" stroke="#d6b88e" />
      <rect x="1040" y="10" width="28" height="14" rx="2" fill="#f2b36f" />
    </g>

    <!-- 책 더미와 화분 -->
    <g stroke="#5b4a3f" stroke-width="2">
      <rect x="930" y="232" width="150" height="30" rx="3" fill="#6f93b8" />
      <rect x="940" y="208" width="130" height="24" rx="3" fill="#e6c79a" />
      <rect x="935" y="186" width="120" height="22" rx="3" fill="#7d9fc0" />
      <path d="M1110 262 l8 -52 h56 l8 52Z" fill="#d48d5c" />
    </g>
    <g fill="#8fb36a" stroke="#5f8a45" stroke-width="2">
      <path d="M1146 210 C1120 180 1120 150 1140 130 C1155 160 1155 185 1146 210Z" />
      <path d="M1146 210 C1170 175 1195 170 1210 175 C1195 200 1175 210 1146 210Z" />
      <path d="M1146 210 C1130 190 1100 185 1090 190 C1105 210 1125 215 1146 210Z" />
    </g>

    <!-- 노트북 -->
    <g stroke="#5b4a3f" stroke-width="2.5" stroke-linejoin="round">
      <path d="M520 262 l18 -88 a6 6 0 0 1 6 -5 h150 a6 6 0 0 1 6 7 l-14 86Z" fill="#b9bcc4" />
      <circle cx="612" cy="215" r="13" fill="#f2d6aa" stroke-width="1.8" />
    </g>

    <!-- 엎드린 마스코트 -->
    <g transform="translate(650 95)" stroke="#5b4a3f" stroke-width="3" stroke-linejoin="round">
      <path d="M40 170 C10 150 0 110 20 80 C20 40 60 10 105 15 C150 0 200 20 210 60 C245 70 265 110 250 150 C255 170 240 175 230 175Z" fill="#fffdf8" />
      <path d="M38 70 C15 75 10 115 30 128 C40 112 45 90 38 70Z" fill="#f6eadb" stroke-width="2.5" />
      <ellipse cx="62" cy="122" rx="14" ry="8" fill="#f9b8a8" stroke="none" />
      <ellipse cx="152" cy="120" rx="14" ry="8" fill="#f9b8a8" stroke="none" />
      <circle cx="82" cy="104" r="6" fill="#3d3029" stroke="none" />
      <circle cx="132" cy="102" r="6" fill="#3d3029" stroke="none" />
      <ellipse cx="107" cy="113" rx="5" ry="4" fill="#3d3029" stroke="none" />
      <path d="M97 121 c4 6 10 4 10 -2 c0 6 6 8 10 2" fill="none" stroke-width="2.5" stroke-linecap="round" />
      <path d="M95 172 C90 150 118 140 140 150 C150 160 142 172 142 172Z" fill="#fffdf8" stroke-width="2.5" />
    </g>

    <!-- 머리 위 병아리 -->
    <g transform="translate(748 68)" stroke="#5b4a3f" stroke-width="2.5">
      <ellipse cx="30" cy="34" rx="30" ry="24" fill="#ffd650" />
      <path d="M22 11 c2 -9 10 -11 14 -5" fill="none" />
      <circle cx="22" cy="30" r="3" fill="#3d3029" stroke="none" />
      <circle cx="40" cy="30" r="3" fill="#3d3029" stroke="none" />
      <path d="M27 36 l4 5 l4 -5Z" fill="#f29a3d" stroke-width="1.5" />
    </g>

    <!-- 머그컵 -->
    <g transform="translate(872 202)" stroke="#5b4a3f" stroke-width="2.5">
      <path d="M0 0 h60 v46 a10 10 0 0 1 -10 10 h-40 a10 10 0 0 1 -10 -10Z" fill="#fffaf2" />
      <path d="M60 12 c18 0 18 26 0 26" fill="none" />
      <ellipse cx="30" cy="2" rx="28" ry="5" fill="#8a5a3c" stroke-width="1.5" />
      <circle cx="30" cy="30" r="9" fill="#f2d6aa" stroke-width="1.5" />
    </g>
  </svg>
  <p class="hero-text hand">{HERO.left}</p>
  <p class="hero-note hand">{HERO.right} <span class="heart">♥</span></p>
</section>
