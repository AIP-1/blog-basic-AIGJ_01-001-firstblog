---
// 글 목록을 카드로 보여줍니다. featured면 첫 글을 크게, 나머지는 2열 카드로.
import PostCard from './PostCard.astro';
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
  featured?: boolean;
}
const { posts, featured = false } = Astro.props;
const lead = featured ? posts[0] : undefined;
const grid = lead ? posts.slice(1) : posts;
---

{posts.length === 0 && <p class="empty">아직 글이 없어요.</p>}
{lead && <PostCard post={lead} featured />}
{grid.length > 0 && (
  <div class="post-grid">
    {grid.map((post) => <PostCard post={post} />)}
  </div>
)}
