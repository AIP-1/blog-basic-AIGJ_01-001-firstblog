---
// 오른쪽 사이드바: 최근 글(썸네일), 카테고리(색 점), 손글씨 카드, 태그
import Thumb from './Thumb.astro';
import Mascot from './Mascot.astro';
import Icon from './Icon.astro';
import { getPosts, getCategoryTree, getTags } from '../lib/posts';
import { categoryStyle } from '../lib/theme';
import { NOTES, url } from '../consts';

const posts = await getPosts();
const tree = await getCategoryTree();
const tags = (await getTags()).slice(0, 15);
const recent = posts.slice(0, 5);

const short = (d: Date) =>
  d.toLocaleDateString('sv-SE', { timeZone: 'Asia/Seoul' }).replaceAll('-', '.');
---

<aside class="sidebar">
  <section class="card side-box">
    <h3>최근 글 <a class="more" href={url('')}>더보기 <Icon name="chevron" size={12} /></a></h3>
    <ul class="recent">
      {recent.map((post) => (
        <li>
          <a href={url(`blog/${post.id}/`)}>
            <Thumb post={post} class="mini" />
            <span>
              <strong>{post.data.title}</strong>
              <small>{short(post.data.pubDate)}</small>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="card side-box">
    <h3>카테고리 <a class="more" href={url('')}>전체 {posts.length} <Icon name="chevron" size={12} /></a></h3>
    <ul class="cat-dots">
      {tree.map((node) => (
        <li>
          <a href={url(`category/${node.path}/`)}>
            <i style={`background:${categoryStyle(node.name).color}`}></i>
            {node.name}
            <span class="count">{node.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <div class="quote-card hand">
    <p><span data-setting="noteRight">{NOTES.right}</span> <span class="heart">♥</span></p>
    <Mascot class="quote-mascot" size={96} />
  </div>

  {tags.length > 0 && (
    <section class="card side-box">
      <h3>태그 <a class="more" href={url('tags/')}>더보기 <Icon name="chevron" size={12} /></a></h3>
      <div class="tags">
        {tags.map((t) => (
          <a class="tag" href={url(`tags/${t.name}/`)}>#{t.name}</a>
        ))}
      </div>
    </section>
  )}
</aside>
