---
// 카테고리별 글 목록 (/category/개발/ , /category/개발/Astro/ 같은 주소)
// 상위 카테고리 페이지에는 하위 카테고리 글도 함께 보입니다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, getCategoryTree, flattenTree, inCategory } from '../../lib/posts';
import { url } from '../../consts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const nodes = flattenTree(await getCategoryTree());
  return nodes.map((node) => ({
    params: { path: node.path },
    props: { node, posts: posts.filter((p) => inCategory(p, node.path)) },
  }));
}

const { node, posts } = Astro.props;
const parts = node.path.split('/');
---

<BaseLayout title={node.path.replaceAll('/', ' › ')}>
  <p class="breadcrumb">
    <a href={url('')}>전체</a>
    {parts.map((name, i) => (
      <> › <a href={url(`category/${parts.slice(0, i + 1).join('/')}/`)}>{name}</a></>
    ))}
  </p>
  <h1 class="page-title">{node.name}</h1>
  <p class="intro">{posts.length}개의 글</p>
  {node.children.length > 0 && (
    <div class="tags subcats">
      {node.children.map((c) => (
        <a class="tag" href={url(`category/${c.path}/`)}>{c.name} ({c.count})</a>
      ))}
    </div>
  )}
  <PostList posts={posts} />
</BaseLayout>
