---
// 마이페이지: 프로필 사진과 손글씨 문구를 바꿉니다.
// (로그인 연결 전이라 지금은 이 브라우저에만 저장됩니다)
import { readdirSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { GREETING, NOTES, PROFILE_IMAGE, url } from '../consts';

// public/profiles 폴더에 있는 그림을 모두 후보로 보여줍니다.
const profiles = readdirSync('public/profiles')
  .filter((f) => /\.(webp|png|jpe?g|gif|svg)$/i.test(f))
  .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
  .map((f) => `/profiles/${f}`);

const defaults = { profileImage: PROFILE_IMAGE, greeting: GREETING, noteLeft: NOTES.left, noteRight: NOTES.right };
---

<BaseLayout title="마이페이지">
  <div class="mypage">
    <h1 class="page-title">마이페이지</h1>
    <p class="intro">프로필 사진과 블로그 곳곳의 문구를 바꿀 수 있어요. 바꾸는 즉시 양옆 사이드바에 미리 보여요.</p>

    <p class="notice">
      로그인 기능은 준비 중이에요. 지금은 저장해도 <strong>이 브라우저에서만</strong> 바뀌고, 다른 방문자에게는 기본 설정이 보여요.
    </p>

    <form id="settings-form" data-defaults={JSON.stringify(defaults)}>
      <fieldset>
        <legend>프로필 사진</legend>
        <div class="profile-picker">
          {profiles.map((src, i) => (
            <label>
              <input type="radio" name="profileImage" value={src} />
              <img src={url(src)} alt={`프로필 후보 ${i + 1}`} width="84" height="84" loading="lazy" />
            </label>
          ))}
        </div>
      </fieldset>

      <label class="field">
        <span>인사말 <small>프로필 사진 아래</small></span>
        <textarea name="greeting" rows="2"></textarea>
      </label>
      <label class="field">
        <span>왼쪽 메모 <small>카테고리 아래 노란 메모</small></span>
        <textarea name="noteLeft" rows="3"></textarea>
      </label>
      <label class="field">
        <span>오른쪽 카드 <small>카테고리 아래 분홍 카드</small></span>
        <textarea name="noteRight" rows="4"></textarea>
      </label>

      <div class="form-actions">
        <button type="submit" class="btn primary">저장</button>
        <button type="button" class="btn" id="reset-btn">기본값으로</button>
        <span id="save-status" class="meta" role="status"></span>
      </div>
    </form>
  </div>
</BaseLayout>

<script>
  import { loadSettings, saveSettings, resetSettings, applySettings, type Settings } from '../lib/settings-store';

  const form = document.getElementById('settings-form') as HTMLFormElement;
  const status = document.getElementById('save-status')!;
  const defaults: Required<Settings> = JSON.parse(form.dataset.defaults!);

  const read = (): Settings => Object.fromEntries(new FormData(form)) as Settings;
  const fill = (s: Settings) => {
    const v = { ...defaults, ...s };
    for (const radio of form.querySelectorAll<HTMLInputElement>('[name=profileImage]')) {
      radio.checked = radio.value === v.profileImage;
    }
    (['greeting', 'noteLeft', 'noteRight'] as const).forEach((k) => {
      (form.elements.namedItem(k) as HTMLTextAreaElement).value = v[k];
    });
  };

  loadSettings().then(fill);

  // 입력하는 대로 사이드바에 미리 보기
  form.addEventListener('input', () => {
    applySettings({ ...defaults, ...read() });
    status.textContent = '저장하지 않은 변경이 있어요.';
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    await saveSettings(read());
    status.textContent = '저장했어요!';
  });

  document.getElementById('reset-btn')!.addEventListener('click', async () => {
    await resetSettings();
    fill({});
    applySettings(defaults);
    status.textContent = '기본값으로 되돌렸어요.';
  });
</script>
